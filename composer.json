{
    "name": "gdi/apilogger",
    "description": "A Laravel package for logging and debugging API requests.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "GDI",
            "email": "dev@gdi.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "GDI\\ApiLogger\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GDI\\ApiLogger\\Providers\\ApiLoggerServiceProvider"
            ],
            "aliases": {
                "ApiLogger": "GDI\\ApiLogger\\Facades\\ApiLogger"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
